# ============================
#  Django / Wagtail
# ============================
DJANGO_SETTINGS_MODULE=prepared_blog.settings.dev
DJANGO_SECRET_KEY=change-me-please-with-secrets-token-urlsafe-50
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=staging.theprepared.local,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.theprepared.local

WAGTAILADMIN_BASE_URL=https://staging.theprepared.local
WAGTAIL_SITE_NAME=The Prepared
WAGTAIL_ADMIN_URL_PATH=m-prepared-admin/   # 어드민 URL 위장

# 호스트(Traefik 라벨용)
BLOG_HOST=staging.theprepared.local

# UID/GID — 호스트와 매칭
UID=1002
GID=1002

# ============================
#  PostgreSQL (postgres_db 컨테이너 재사용, 새 DB)
# ============================
PG_HOST=postgres_db
PG_PORT=5432
PG_DB=prepared_blog
PG_USER=theprepared
PG_PASSWORD=dnflxksdir1!

# ============================
#  Redis (DB index 분리: invest=0/1, blog=2/3/4)
# ============================
REDIS_URL_CACHE=redis://redis:6379/2
REDIS_URL_BROKER=redis://redis:6379/3
REDIS_URL_RESULT=redis://redis:6379/4

# ============================
#  Email (관리자 알림)
# ============================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=The Prepared <no-reply@theprepared.local>
ADMIN_EMAIL=5ll34090@gmail.com

# ============================
#  Discord 알림
# ============================
DISCORD_WEBHOOK_URL=

# ============================
#  Gemini (invest의 키 그대로 사용. invest/.env에서 복사)
# ============================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ============================
#  지도 API
# ============================
NAVER_MAP_NCP_CLIENT_ID=
NAVER_MAP_NCP_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# ============================
#  SEO / Verification
# ============================
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# ============================
#  reCAPTCHA v3 (invisible)
# ============================
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
RECAPTCHA_REQUIRED_SCORE=0.5

# ============================
#  WordPress 마이그레이션 (원본)
# ============================
WP_BASE_URL=https://theprepared.kr
WP_APP_USER=
WP_APP_PASSWORD=
WP_UPLOADS_PATH=/wp-uploads

# ============================
#  Sentry (선택)
# ============================
SENTRY_DSN=
SENTRY_ENV=staging

# ============================
#  보안 토큰
# ============================
VISITOR_TOKEN_SECRET=change-me-hmac-secret-for-ip-hashing
COMMENT_FORM_TIMETRAP_SECRET=change-me-form-render-signing-secret
